rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    match /activeProfiles/{profileId} {
      // Anyone can read active profiles (both single doc and list query)
      allow read: if true;
      // Allow write operations with valid ID
      allow write: if isValidId(profileId);
    }

    match /pendingProfiles/{profileId} {
      // Allow read (both single doc and list query)
      allow read: if true;
      allow write: if isValidId(profileId);
    }

    match /trashProfiles/{profileId} {
      // Allow read (both single doc and list query)
      allow read: if true;
      allow write: if isValidId(profileId);
    }

    match /profileAssets/{assetId} {
      // Allow read and write for dedicated asset documents (PDFs & media)
      allow read: if true;
      allow write: if isValidId(assetId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
